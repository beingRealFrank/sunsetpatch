{
 "version": "1.0.0",
 "packs": {
  "apple-ads": {
   "name": "Apple Ads Campaign Management API",
   "cutoff": "2027-01-26",
   "hard": true,
   "source": "https://developer.apple.com/documentation/apple_ads/apple-search-ads-campaign-management-api-5",
   "replacement": "Apple Ads Platform API (https://api.ads.apple.com/v1/)",
   "replacement_url": "https://developer.apple.com/documentation/apple-ads-platform-api"
  },
  "google-cse": {
   "name": "Google Custom Search JSON API",
   "cutoff": "2027-01-01",
   "hard": true,
   "source": "https://developers.google.com/custom-search/v1/overview",
   "replacement": "Vertex AI Search (site search) or another search API",
   "replacement_url": "https://cloud.google.com/use-cases/site-search"
  },
  "ews": {
   "name": "Exchange Web Services (Exchange Online)",
   "cutoff": "2027-04-01",
   "hard": true,
   "source": "https://learn.microsoft.com/exchange/clients-and-mobile-in-exchange-online/deprecation-of-ews-exchange-online",
   "replacement": "Microsoft Graph (mail, calendar, contacts)",
   "replacement_url": "https://aka.ms/ews2graphMap"
  },
  "hubspot": {
   "name": "HubSpot numbered-version APIs (v1-v4)",
   "cutoff": "2027-03-30 (v4) / 2027-09 (v1-v3)",
   "hard": false,
   "source": "https://developers.hubspot.com/changelog/legacy-apis-and-legacy-apps-whats-going-unsupported-and-when",
   "replacement": "HubSpot date-based API versions (e.g. 2026-09)",
   "replacement_url": "https://developers.hubspot.com/docs/api-reference/legacy/migration-guide"
  },
  "keap": {
   "name": "Keap (Infusionsoft) XML-RPC API",
   "cutoff": "2027-03-15 (deprecation, no support)",
   "hard": false,
   "source": "https://learn.thryv.com/hc/en-us/articles/41277574163469-Keap-s-XMLRPC-API-Sunset",
   "replacement": "Keap REST v2 (https://api.infusionsoft.com/crm/rest/v2/)",
   "replacement_url": "https://developer.infusionsoft.com/docs/restv2/"
  }
 },
 "rules": [
  {
   "pack": "apple-ads",
   "id": "host",
   "re": "api\\.searchads\\.apple\\.com",
   "msg": "Old Apple Ads host. Replace with https://api.ads.apple.com/v1/ (paths change too, see mapping)."
  },
  {
   "pack": "apple-ads",
   "id": "path",
   "re": "/api/v[2-5]/[A-Za-z{$<:%][^\\s\\\"'`)]*",
   "msg": "Campaign Management API path; see suggested Platform API equivalent."
  },
  {
   "pack": "apple-ads",
   "id": "context-org",
   "re": "X-AP-Context[^\\n]{0,80}orgId|orgId=\\{?|[\\\"']orgId=",
   "msg": "X-AP-Context now takes adAccountId=<id> (from GET /v1/acls), not orgId."
  },
  {
   "pack": "apple-ads",
   "id": "reports",
   "re": "reports/campaigns",
   "msg": "v5 reports become POST /v1/reports/apps/{campaigns|adgroups|ads|keywords|searchterms}/query with a new request body and response envelope (result.rows[].totalMetrics)."
  },
  {
   "pack": "apple-ads",
   "id": "nested",
   "re": "targetingkeywords|negativekeywords|creativesets|creative-sets|adgroups/find|campaigns/find|custom-reports",
   "msg": "Nested/find-style v5 resource; Platform API uses top-level resources with POST /v1/<resource>/query filters."
  },
  {
   "pack": "apple-ads",
   "id": "resource",
   "re": "[\\\"'`]/?(?:campaigns|adgroups|acls|me|budgetorders|creatives|search/apps|search/geo|countries-or-regions|product-page-reasons)(?:[/?{][^\\\"'`\\s]*)?[\\\"'`]",
   "msg": "v5 resource path string; see suggested Platform API equivalent."
  },
  {
   "pack": "apple-ads",
   "id": "selector",
   "re": "[\\\"']selector[\\\"']\\s*:|\\\"conditions\\\"\\s*:",
   "msg": "v5 Selector bodies (conditions/orderBy/pagination) become QueryRequest {filters, sorting, pagination}."
  },
  {
   "pack": "apple-ads",
   "id": "sdk",
   "re": "\\bsearchads_api\\b|apple-search-ads-go|tap-apple-search-ads|source-apple-search-ads|apple_search_ads|AppleSearchAds|asa-api|searchads-api",
   "msg": "Library or connector built on the old API; check its version supports the Platform API before Jan 26, 2027."
  },
  {
   "pack": "apple-ads",
   "id": "budget",
   "re": "\\bbudgetAmount\\b|\\blifetimeBudget\\b",
   "msg": "Lifetime budgetAmount was removed (June 2026); use dailyBudgetAmount."
  },
  {
   "pack": "google-cse",
   "id": "endpoint",
   "re": "googleapis\\.com/customsearch/v1",
   "msg": "Custom Search JSON API endpoint; discontinued for existing customers on Jan 1, 2027."
  },
  {
   "pack": "google-cse",
   "id": "client",
   "re": "build\\(\\s*[\\\"']customsearch[\\\"']|\\.cse\\(\\)|customsearch_v1|google\\.customsearch|CustomsearchService|customsearch\\.cse",
   "msg": "Custom Search client library call."
  },
  {
   "pack": "google-cse",
   "id": "cx",
   "re": "[?&]cx=|[\\\"']cx[\\\"']\\s*:",
   "msg": "Programmable Search Engine id (cx) passed to the JSON API."
  },
  {
   "pack": "ews",
   "id": "endpoint",
   "re": "outlook\\.office365\\.com/EWS|/EWS/Exchange\\.asmx|outlook\\.office\\.com/EWS",
   "msg": "EWS endpoint on Exchange Online; disabled by default since Oct 2026, fully off Apr 1, 2027."
  },
  {
   "pack": "ews",
   "id": "sdk",
   "re": "Microsoft\\.Exchange\\.WebServices|\\bexchangelib\\b|ews-javascript-api|ews-java-api|\\bExchangeService\\s*\\(|microsoft\\.exchange\\.webservices|php-ews|jamesiarmes|garethp/php-ews|node-ews|\\bviewpoint\\b.*ews",
   "msg": "EWS client library; replace with Microsoft Graph SDK calls."
  },
  {
   "pack": "ews",
   "id": "usage",
   "re": "\\bExchangeService\\b|\\bEmailMessage\\b|\\bItemView\\b|\\bFolderView\\b|\\bWellKnownFolderName\\b|\\bFindItems\\b|\\bSendAndSaveCopy\\b|\\bCalendarFolder\\b|\\bAppointment\\.Bind\\b|\\bAccount\\(|\\bConfiguration\\(|\\.inbox\\b|\\.calendar\\b|\\bOAuth2Credentials\\b|\\bWebCredentials\\b|\\bExchangeCredentials\\b",
   "msg": "EWS object/call; maps to a Microsoft Graph request (see the EWS-to-Graph map)."
  },
  {
   "pack": "ews",
   "id": "soap",
   "re": "schemas\\.microsoft\\.com/exchange/services/2006",
   "msg": "Raw EWS SOAP payload."
  },
  {
   "pack": "ews",
   "id": "scope",
   "re": "EWS\\.AccessAsUser\\.All|full_access_as_app|outlook\\.office365\\.com/\\.default",
   "msg": "EWS OAuth scope; Graph needs Mail.*/Calendars.* scopes instead."
  },
  {
   "pack": "hubspot",
   "id": "host",
   "re": "api\\.hubapi\\.com|api\\.hubspot\\.com",
   "msg": "HubSpot API host (anchor; see the version-specific findings)."
  },
  {
   "pack": "hubspot",
   "id": "v1-v3-legacy",
   "re": "api\\.hubapi\\.com/(?:contacts|deals|companies|engagements|owners|properties|crm-associations|email|forms|form-integrations|automation|content|blogs|calendar|reports|events|analytics|marketing-emails|cms|broadcast|social|files|crm-pipelines|integrations|webhooks|marketing|conversations|crm-objects|extensions)/v[1-3]\\b",
   "msg": "Legacy numbered HubSpot endpoint; unsupported after Sept 2027 (marketplace apps lose certification)."
  },
  {
   "pack": "hubspot",
   "id": "crm-v3",
   "re": "/crm/v3/",
   "msg": "HubSpot CRM v3 endpoint; unsupported after Sept 2027. Migrate straight to date-based versions."
  },
  {
   "pack": "hubspot",
   "id": "crm-v4",
   "re": "/crm/v4/",
   "msg": "HubSpot CRM v4 endpoint; unsupported from March 2027."
  },
  {
   "pack": "hubspot",
   "id": "hapikey",
   "re": "hapikey=|\\bhapikey\\b",
   "msg": "Legacy HubSpot API key (removed 2022); use a private app token or Service Key."
  },
  {
   "pack": "hubspot",
   "id": "sdk",
   "re": "@hubspot/api-client|hubspot-api-client|\\bhubspot3\\b|hubspot/api-client|HubSpot\\\\Factory|hubspot-php",
   "msg": "HubSpot SDK; check the version targets date-based APIs."
  },
  {
   "pack": "keap",
   "id": "endpoint",
   "re": "infusionsoft\\.com/(?:crm/)?(?:api/)?xmlrpc|/crm/xmlrpc|api/xmlrpc",
   "msg": "Keap XML-RPC endpoint; deprecated, no support from March 2027. Move to REST v2."
  },
  {
   "pack": "keap",
   "id": "method",
   "re": "\\b(?:ContactService|DataService|InvoiceService|OrderService|ProductService|FunnelService|APIEmailService|APIAffiliateService|AffiliateService|AffiliateProgramService|ShippingService|WebFormService|SearchService|FileService|DiscountService|CreditCardSubmissionService|WebTrackingService)\\.[a-zA-Z]+",
   "msg": "Keap XML-RPC service method; see Keap's XML-RPC to REST v2 mapping guide."
  },
  {
   "pack": "keap",
   "id": "sdk",
   "re": "\\biSDK\\b|novaksolutions/infusionsoft|infusionsoft-php-sdk|\\binfusionsoft-python\\b|\\bInfusionsoft\\\\Infusionsoft\\b|isdk\\.php|xmlrpc\\.client\\.ServerProxy\\([^)]*infusionsoft",
   "msg": "Keap XML-RPC SDK or client."
  },
  {
   "pack": "keap",
   "id": "rest-v1",
   "re": "crm/rest/v1/",
   "msg": "Keap REST v1 (not part of this sunset, but Keap points new work at REST v2)."
  }
 ],
 "anchors": {
  "apple-ads": [
   "host",
   "sdk"
  ],
  "google-cse": [
   "client",
   "endpoint"
  ],
  "ews": [
   "endpoint",
   "scope",
   "sdk",
   "soap"
  ],
  "hubspot": [
   "hapikey",
   "host",
   "sdk",
   "v1-v3-legacy"
  ],
  "keap": [
   "endpoint",
   "sdk"
  ]
 },
 "apple_map": [
  [
   "reports/campaigns/[^/]+/adgroups/[^/]+/keywords",
   "POST /v1/reports/apps/keywords/query (filter campaignId, adGroupId)"
  ],
  [
   "reports/campaigns/[^/]+/adgroups/[^/]+/searchterms",
   "POST /v1/reports/apps/searchterms/query (filter campaignId, adGroupId)"
  ],
  [
   "reports/campaigns/[^/]+/adgroups",
   "POST /v1/reports/apps/adgroups/query (filter campaignId)"
  ],
  [
   "reports/campaigns/[^/]+/ads",
   "POST /v1/reports/apps/ads/query (filter campaignId)"
  ],
  [
   "reports/campaigns/[^/]+/keywords",
   "POST /v1/reports/apps/keywords/query (filter campaignId)"
  ],
  [
   "reports/campaigns/[^/]+/searchterms",
   "POST /v1/reports/apps/searchterms/query (filter campaignId)"
  ],
  [
   "reports/campaigns",
   "POST /v1/reports/apps/campaigns/query"
  ],
  [
   "custom-reports",
   "POST /v1/insights/apps/impression-share/query"
  ],
  [
   "targetingkeywords/delete/bulk",
   "POST /v1/keywords/bulk-delete"
  ],
  [
   "negativekeywords/delete/bulk",
   "POST /v1/negative-keywords/bulk-delete"
  ],
  [
   "targetingkeywords/bulk",
   "POST /v1/keywords/bulk-create (POST) or /v1/keywords/bulk-update (PUT)"
  ],
  [
   "negativekeywords/bulk",
   "POST /v1/negative-keywords/bulk-create (POST) or /bulk-update (PUT)"
  ],
  [
   "targetingkeywords/find",
   "POST /v1/keywords/query"
  ],
  [
   "negativekeywords/find",
   "POST /v1/negative-keywords/query"
  ],
  [
   "targetingkeywords/[^/\\s\\\"']+",
   "GET|PUT|DELETE /v1/keywords/{id}"
  ],
  [
   "targetingkeywords",
   "POST /v1/keywords/query (filter adGroupId)"
  ],
  [
   "negativekeywords/[^/\\s\\\"']+",
   "GET|PUT|DELETE /v1/negative-keywords/{id}"
  ],
  [
   "negativekeywords",
   "POST /v1/negative-keywords/query (filter campaignId or adGroupId)"
  ],
  [
   "(?:campaigns/[^/]+/)?ads/find",
   "POST /v1/ads/query"
  ],
  [
   "adgroups/[^/]+/ads/[^/\\s\\\"']+",
   "GET|PUT|DELETE /v1/ads/{id}"
  ],
  [
   "adgroups/[^/]+/ads",
   "POST /v1/ads (create) or POST /v1/ads/query (filter adGroupId)"
  ],
  [
   "adgroups/find",
   "POST /v1/adgroups/query"
  ],
  [
   "campaigns/[^/]+/adgroups/[^/\\s\\\"']+",
   "GET|PUT|DELETE /v1/adgroups/{id}"
  ],
  [
   "campaigns/[^/]+/adgroups",
   "POST /v1/adgroups (create) or POST /v1/adgroups/query (filter campaignId)"
  ],
  [
   "campaigns/find",
   "POST /v1/campaigns/query"
  ],
  [
   "campaigns/[^/\\s\\\"']+",
   "GET|PUT|DELETE /v1/campaigns/{id}"
  ],
  [
   "campaigns",
   "POST /v1/campaigns (create) or POST /v1/campaigns/query (list)"
  ],
  [
   "creativesets|creative-sets",
   "Removed (creative sets were deprecated); use creatives + ads"
  ],
  [
   "creatives/find",
   "POST /v1/creatives/query"
  ],
  [
   "creatives",
   "/v1/creatives, /v1/creatives/{id}, POST /v1/creatives/query"
  ],
  [
   "apps/[^/]+/eligibilities/find",
   "POST /v1/eligibilities/apps/query"
  ],
  [
   "apps/[^/]+/product-pages",
   "POST /v1/product-pages/query, GET /v1/product-pages/{id}"
  ],
  [
   "apps/[^/]+/locale-details",
   "POST /v1/apps/{adamId}/locale-details/query"
  ],
  [
   "apps/[^/]+/assets/find",
   "No direct equivalent; ads use product pages (check docs)"
  ],
  [
   "product-page-reasons",
   "POST /v1/rejection-reasons/apps/query"
  ],
  [
   "budgetorders",
   "Budget orders are org-scoped in the Platform API (see budget-orders-endpoints)"
  ],
  [
   "search/apps",
   "GET /v1/search/apps"
  ],
  [
   "search/geo",
   "GET|POST /v1/search/geo"
  ],
  [
   "countries-or-regions",
   "Check Platform API CampaignTargeting values"
  ],
  [
   "acls",
   "GET /v1/acls (now also returns ad accounts)"
  ],
  [
   "\\bme\\b",
   "GET /v1/me"
  ]
 ],
 "apple_rel": "(?:reports/campaigns|custom-reports|campaigns|adgroups|creativesets|creatives|apps/|budgetorders|product-page-reasons|search/(?:apps|geo)|countries-or-regions|acls\\b|ads/find)[^\\s\\\"'`)?]*",
 "path_hints": {
  "apple-ads": "apple|searchads|search_ads|search-ads|(^|[/_.-])asa([/_.-]|$)",
  "google-cse": "customsearch|custom_search|(^|[/_.-])cse([/_.-]|$)",
  "ews": "(^|[/_.-])ews([/_.-]|$)|exchange",
  "hubspot": "hubspot",
  "keap": "keap|infusion"
 }
}
